{
  "name": "web-svelte",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "import:inspect": "node scripts/inspect-bank-import.mjs",
    "seed:local": "SEED_TARGET=local node ./scripts/seed-personas.mjs",
    "seed:staging": "node ./scripts/seed-staging.mjs",
    "test:e2e": "bash ../../scripts/with-ci-fonts.sh playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:deps": "playwright install --with-deps chromium",
    "postinstall": "playwright install chromium",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:rls": "vitest run",
    "test:rls:watch": "vitest",
    "cap:sync": "cap sync android",
    "android:sync": "pnpm build && cap sync android",
    "android:sync:prod": "bash ./scripts/android-release.sh --sync-only",
    "android:open": "cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:release": "bash ./scripts/android-release.sh",
    "test:e2e:matrix": "bash ../../scripts/with-ci-fonts.sh playwright test --config playwright.matrix.config.ts",
    "test:e2e:local": "bash ../../scripts/with-ci-fonts.sh node scripts/test-local-flows.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.5",
    "canvas-confetti": "^1.9.4",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.7.4",
    "@internationalized/date": "^3.12.4",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/svelte-query": "^6.3.5",
    "@tanstack/svelte-query-devtools": "^6.3.5",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "dayjs": "^1.11.23",
    "layerchart": "^1.0.13",
    "lucide-svelte": "^1.0.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^5.3.0"
  }
}
